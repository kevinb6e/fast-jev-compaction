{
  "name": "fast-jev-compaction",
  "version": "0.7.0",
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/opencode/server.d.ts",
      "import": "./opencode/server.js"
    },
    "./opencode": {
      "types": "./dist/opencode/server.d.ts",
      "import": "./opencode/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "opencode",
    "omp",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/opencode/server.ts --bundle --format=esm --platform=node --target=node18 --outfile=opencode/server.js --log-level=warning",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:adapters",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "bump": "node scripts/bump.mjs",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "typecheck:adapters": "tsc -p tsconfig.adapters.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "omp": {
    "extensions": [
      "./omp/index.ts"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.4.3",
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode/plugin": "^2.0.19",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
